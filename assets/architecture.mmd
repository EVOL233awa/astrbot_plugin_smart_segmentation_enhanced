flowchart TB
    subgraph AstrBot["AstrBot 事件层"]
        Hook1["on_llm_response（预计算）"]
        Hook2["on_decorating_result（替换首段）"]
        Hook3["after_message_sent（启动补发）"]
    end

    subgraph Main["主控层"]
        Config["SegmentationSettings"]
        Cache["预分段缓存"]
        Locks["会话串行锁"]
        Pending["补发任务管理"]
        Scheduler["异步补发调度"]
    end

    subgraph Engine["segmentation.py 分段引擎"]
        Clean["Markdown 清洗 off/light/heavy"]
        Detect["检测：本地/非自然语言/受保护块"]
        Protect["JSON/Markdown 块保护"]
        LLM["LLM 分段调用与解析"]
        Reconstruct["原文标点重建"]
        Leading["前导标点归属规则"]
        Brackets["括号边界切分"]
        Local["本地高精切分"]
        Stabilize["长度稳定/平衡打包"]
    end

    subgraph External["外部"]
        Provider["分段 LLM Provider"]
        Chain["AstrBot MessageChain"]
        Deps["可选依赖 markdown-it / mdit_plain"]
    end

    Hook1 --> Config
    Hook1 --> Clean
    Clean --> Detect
    Clean -->|heavy 时可选| Deps
    Detect --> Protect
    Protect --> Local
    Detect -->|仅非保护块| LLM
    LLM -->|调用| Provider
    LLM --> Reconstruct
    Reconstruct --> Leading
    Leading --> Brackets
    Brackets --> Stabilize
    Local --> Stabilize
    Stabilize --> Cache
    Hook2 --> Cache
    Hook2 -->|缓存未命中| Local
    Cache --> Locks
    Hook2 --> Chain
    Hook3 --> Pending
    Pending --> Scheduler
    Scheduler --> Chain
