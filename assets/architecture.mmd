flowchart TB
    subgraph AstrBot["AstrBot 事件层"]
        Hook1["on_llm_response（预计算）"]
        Hook2["on_decorating_result（替换首段）"]
        Hook3["after_message_sent（启动补发）"]
    end

    subgraph Main["主控层 main.py"]
        Config["SegmentationSettings"]
        Cache["预分段缓存检索：精确哈希 / 签名相等 / 前缀拼合 / contains 对齐"]
        Locks["会话串行锁"]
        Pending["补发任务管理"]
        Scheduler["异步补发调度"]
    end

    subgraph Engine["segmentation.py 分段引擎"]
        Clean["Markdown 清洗 off/light/heavy"]
        Detect["检测：use_local_only / 非自然语言 / 受保护块"]
        PipeMask["管道符掩码：先掩码正文 |，解析后回填"]
        LLM["LLM 分段调用与解析"]
        Reconstruct["原文标点重建"]
        Leading["前导标点归属"]
        Local["本地高精切分（原子块扫描 / 句中括号回并）"]
        Stabilize["长度稳定 / 全局打包"]
    end

    subgraph External["外部"]
        Provider["分段 LLM Provider"]
        Chain["AstrBot MessageChain"]
    end

    Hook1 --> Config
    Hook1 --> Clean
    Clean --> Detect
    Detect -->|本地 / 受保护块 / use_local_only| Local
    Detect -->|仅非保护块| PipeMask
    PipeMask --> LLM
    LLM -->|调用| Provider
    LLM --> Reconstruct
    Reconstruct --> Leading
    Leading --> Local
    Local --> Stabilize
    Stabilize --> Cache
    Hook2 --> Cache
    Hook2 -->|检索全未命中| Local
    Cache --> Locks
    Hook2 --> Chain
    Hook3 --> Pending
    Pending --> Scheduler
    Scheduler --> Chain
